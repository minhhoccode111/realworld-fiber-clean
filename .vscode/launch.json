{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch main application",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/app",
      "args": ["-tags", "migrate"],
      "env": {
        "APP_NAME": "realworld-fiber-clean",
        "APP_VERSION": "1.0.0",
        "CORS_ALLOW_CREDENTIALS": "true",
        "CORS_ALLOW_HEADERS": "Origin,Content-Type,Accept,Authorization",
        "CORS_ALLOW_METHODS": "GET,POST,HEAD,PUT,DELETE,PATCH",
        "CORS_ALLOW_ORIGINS": "http://localhost:3000,https://rw.minhhoccode111.com",
        "HTTP_PORT": "8080",
        "HTTP_USE_PREFORK_MODE": "false",
        "JWT_EXPIRATION": "2400h",
        "JWT_ISSUER": "realworldfiberclean",
        "JWT_SECRET": "c993332e-1a4e-4de5-ac74-98074ff41ff0",
        "JWT_COOKIE_SECURE": "false",
        "JWT_COOKIE_SAME_SITE": "Lax",
        "LOG_LEVEL": "debug",
        "METRICS_ENABLED": "true",
        "PG_POOL_MAX": "2",
        "PG_URL": "postgresql://mhc:password@localhost:5432/realworld",
        "SWAGGER_ENABLED": "true"
      }
    }
  ]
}
