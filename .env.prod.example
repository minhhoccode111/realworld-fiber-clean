# Production Environment Variables
# Copy this file to .env.prod and fill in the actual values

# App
APP_NAME=realworld-fiber-clean
APP_VERSION=1.0.0

# CORS - Update with your production domain
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_ALLOW_METHODS=GET,POST,HEAD,PUT,DELETE,PATCH
CORS_ALLOW_ORIGINS=https://realworld.minhhoccode111.com

# HTTP settings
HTTP_PORT=8080
HTTP_USE_PREFORK_MODE=false

# JWT - IMPORTANT: Change these in production!
JWT_EXPIRATION=240h
JWT_ISSUER=realworldfiberclean
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAME_SITE=Strict

# Logger
LOG_LEVEL=info

# Metrics
METRICS_ENABLED=true

# PostgreSQL - Connect to db service within Docker network
PG_POOL_MAX=10
PG_URL=postgresql://mhc:password@db:5432/realworld

# Swagger - Disable in production for security
SWAGGER_ENABLED=false

# Database credentials (used by docker-compose.prod.yml)
POSTGRES_USER=mhc
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD
